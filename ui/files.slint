import { UiText, Branding } from "i18n.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";
import { GlassTheme, GlassPanel, Button, CheckBox } from "glass.slint";

export struct FileRow { name: string, detail: string, directory: bool, regular: bool }

export component SshSharingOverlay inherits Rectangle {
    in property <bool> clipboard-view: false;
    in property <bool> native-available: false;
    in-out property <bool> native-enabled: false;
    in-out property <bool> native-receive: true;
    in-out property <bool> native-send: true;
    in-out property <bool> native-files: false;
    in property <string> native-status;
    callback native-changed();
    in-out property <bool> shared;
    in property <string> mode;
    in property <bool> vnc-available: true;
    in property <string> host;
    in-out property <string> port: "22";
    in-out property <string> username;
    in-out property <string> password;
    in property <bool> has-saved;
    in-out property <bool> use-saved;
    in property <bool> connected;
    in property <bool> directory-ready;
    in property <bool> connecting;
    in property <bool> busy;
    in property <bool> key-pending;
    in property <string> fingerprint;
    in property <string> key-algorithm;
    in property <string> key-command;
    in-out property <string> path;
    in-out property <string> upload-name;
    in property <[FileRow]> entries;
    in property <string> status;
    in property <string> error;
    in property <string> progress-label;
    in property <float> progress;
    callback close();
    callback connect();
    callback disconnect();
    callback approve(bool);
    callback browse();
    callback up();
    callback entry(int);
    callback upload();
    callback cancel();
    callback copy-text();
    callback send-text();
    in-out property <bool> auto-enabled: false;
    in-out property <bool> auto-to-mac: true;
    in-out property <bool> auto-to-windows: true;
    in-out property <string> auto-limit: "1048576";
    in property <string> auto-status;
    callback auto-changed();
    callback changed();
    callback paste-text();
    background: GlassTheme.dark ? #00000099 : #00000033;
    TouchArea { clicked => { root.close(); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => { if event.text == Key.Escape { root.close(); return accept; } return reject; }
        GlassPanel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(root.clipboard-view ? 620px : 840px, parent.width - 40px);
            height: min(root.clipboard-view ? 650px : 720px, parent.height - 40px);
            raised: true; radius: 24px;
            TouchArea { }
            VerticalLayout {
                padding: 24px; spacing: 12px;
                HorizontalLayout {
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: UiText.message(root.clipboard-view ? @tr("ui" => "Clipboard") : @tr("ui" => "Files")); color: GlassTheme.ink; font-size: 22px; font-weight: 700; }
                        Text { text: UiText.message(root.host + (root.clipboard-view && root.native-enabled ? @tr("ui" => "  -  Apple encrypted session") : @tr("ui" => "  -  SSH / SFTP"))); color: GlassTheme.muted; font-size: 12px; }
                    }
                    Button { text: @tr("ui" => "Done"); clicked => { root.close(); } }
                }
                ScrollView {
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: sharing-content.preferred-height;
                sharing-content := VerticalLayout {
                spacing: 12px; padding: 4px;
                if root.error != "" : Text { text: UiText.message(root.error); accessible-label: @tr("ui" => "SSH operation error: ") + root.error; color: GlassTheme.dark ? #ff6961 : #c62820; wrap: word-wrap; font-size: 12px; }
                if root.clipboard-view && !root.key-pending : VerticalLayout {
                    spacing: 12px;
                    if root.vnc-available : CheckBox { text: @tr("ui" => "Share plain-text clipboard over VNC"); checked <=> root.shared; enabled: !root.auto-enabled; toggled => { root.changed(); } }
                    Text { text: UiText.message(root.mode); color: GlassTheme.accent; font-size: 12px; wrap: word-wrap; }
                    if root.vnc-available : Text { text: @tr("ui" => "Ctrl+V sends Windows text when pasting into your Mac. Incoming Mac text can replace your Windows clipboard while the viewer is active. Clipboard contents are never logged."); color: GlassTheme.muted; wrap: word-wrap; font-size: 13px; }
                    if root.vnc-available : Button { text: @tr("ui" => "Paste Windows text"); enabled: root.shared && !root.auto-enabled; clicked => { root.paste-text(); } }
                    if root.vnc-available : Text { text: @tr("ui" => "VNC clipboard traffic is not encrypted. Use a VPN. Files, images, and rich text are not shared."); color: GlassTheme.muted; wrap: word-wrap; font-size: 12px; }
                    if root.native-available : VerticalLayout {
                        CheckBox { text: @tr("ui" => "Native Apple clipboard (experimental, no SSH)"); checked <=> root.native-enabled; toggled => { root.native-changed(); } }
                        Text { text: UiText.message(@tr("ui" => "Status: ") + root.native-status); accessible-label: self.text; color: GlassTheme.ink; wrap: word-wrap; font-size: 13px; font-weight: 500; }
                        HorizontalLayout {
                            CheckBox { text: @tr("ui" => "Mac → Windows"); checked <=> root.native-receive; enabled: root.native-enabled; toggled => { root.native-changed(); } }
                            CheckBox { text: @tr("ui" => "Windows → Mac"); checked <=> root.native-send; enabled: root.native-enabled; toggled => { root.native-changed(); } }
                        }
                        Text { text: @tr("ui" => "Uses the current encrypted HEVC connection. New text, HTML/RTF and image copies sync in the selected directions. Remote Login and a second authentication are not used."); color: GlassTheme.muted; wrap: word-wrap; font-size: 11px; }
                        Text { text: @tr("ui" => "Text/HTML/RTF: 1 MiB each. Images: up to 3840×2160 pixels; PNG transfer under 4 MiB. Single-page 8-bit TIFF is converted. File/folder sync is a separate opt-in below."); color: GlassTheme.muted; wrap: word-wrap; font-size: 11px; }
                        CheckBox { text: @tr("ui" => "Sync files and folders (experimental, copy only)"); checked <=> root.native-files; enabled: root.native-enabled; toggled => { root.native-changed(); } }
                        Text { text: @tr("ui" => "Up to 16 roots / 256 MiB per batch. Keep this app open until pasting finishes. Files are staged in Mac /tmp and a private Windows temporary folder. Mac /tmp copies remain until system cleanup; links are not supported. Turn off this option to cancel."); color: GlassTheme.muted; wrap: word-wrap; font-size: 11px; }

                    }
                    Text { text: @tr("ui" => "Encrypted SSH clipboard (optional fallback)"); color: GlassTheme.ink; font-size: 16px; font-weight: 600; }
                    CheckBox { text: @tr("ui" => "Auto Sync Clipboard"); enabled: !root.native-enabled; checked <=> root.auto-enabled; toggled => { root.auto-changed(); } }
                    Text { text: @tr("ui" => "Shares new plain-text copies, including potentially sensitive text, in the background. Default: off. SSH must match the Mac desktop account."); color: GlassTheme.muted; wrap: word-wrap; font-size: 11px; }
                    HorizontalLayout {
                        CheckBox { text: @tr("ui" => "Windows → Mac"); checked <=> root.auto-to-mac; toggled => { root.auto-changed(); } }
                        CheckBox { text: @tr("ui" => "Mac → Windows"); checked <=> root.auto-to-windows; toggled => { root.auto-changed(); } }
                    }
                    HorizontalLayout {
                        Text { text: @tr("ui" => "Text limit (UTF-8 bytes)"); color: GlassTheme.muted; vertical-alignment: center; }
                        LineEdit { text <=> root.auto-limit; accepted => { root.auto-changed(); } }
                        Button { text: @tr("ui" => "Apply"); clicked => { root.auto-changed(); } }
                    }
                    Text { text: UiText.message(root.auto-status); color: GlassTheme.accent; wrap: word-wrap; font-size: 12px; }
                    HorizontalLayout {
                        Button { text: @tr("ui" => "Copy Mac text"); enabled: root.connected && !root.busy && !root.native-enabled; clicked => { root.copy-text(); } }
                        Button { text: @tr("ui" => "Send Windows text"); enabled: root.connected && !root.busy && !root.native-enabled; clicked => { root.send-text(); } }
                    }
                    if root.connected : Button { text: @tr("ui" => "Disconnect SSH"); enabled: !root.busy; clicked => { root.disconnect(); } }
                    Text { text: @tr("ui" => "Unicode clipboard uses this SSH account's logged-in Mac desktop. No images, rich text, or clipboard contents are logged."); color: GlassTheme.muted; wrap: word-wrap; font-size: 11px; }
                }
                if root.key-pending : GlassPanel {
                    radius: 16px;
                    VerticalLayout {
                        padding: 18px; spacing: 15px;
                        Text { text: @tr("ui" => "Verify this Mac's SSH host key"); color: GlassTheme.ink; font-size: 19px; font-weight: 600; }
                        Text { text: UiText.message(root.key-algorithm + "  -  " + root.host + ":" + root.port); color: GlassTheme.muted; font-size: 12px; }
                        LineEdit { text: root.fingerprint; read-only: true; accessible-label: @tr("ui" => "SSH SHA-256 fingerprint"); }
                        Text { text: @tr("ui" => "Compare this fingerprint on the Mac before trusting it. A changed key is always blocked. No saved password is read or sent before the key is accepted."); color: GlassTheme.ink; wrap: word-wrap; font-size: 13px; }
                        Text { text: @tr("ui" => "On the Mac, run:"); color: GlassTheme.muted; font-size: 12px; }
                        Text { text: UiText.message(root.key-command); color: GlassTheme.ink; wrap: word-wrap; font-size: 12px; }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        HorizontalLayout {
                            Button { text: @tr("ui" => "Reject"); clicked => { root.approve(false); } }
                            Button { text: @tr("ui" => "Trust key & continue"); primary: true; clicked => { root.approve(true); } }
                        }
                    }
                }
                if !root.connected && !root.key-pending && (!root.clipboard-view || !root.native-enabled) : VerticalLayout {
                    spacing: 14px;
                    Text { text: @tr("ui" => "On your Mac: System Settings > General > Sharing > Remote Login. Allow your Mac account."); color: GlassTheme.muted; wrap: word-wrap; font-size: 13px; }
                    HorizontalLayout {
                        Text { text: @tr("ui" => "SSH port"); color: GlassTheme.muted; vertical-alignment: center; }
                        LineEdit { text <=> root.port; enabled: !root.connecting; max-width: 100px; accessible-label: @tr("ui" => "SSH port"); }
                        Rectangle { background: transparent; horizontal-stretch: 1; }
                    }
                    if root.has-saved : CheckBox { text: @tr("ui" => "Use saved Mac login (Windows Hello required)"); checked <=> root.use-saved; enabled: !root.connecting; }
                    if root.use-saved : Text { text: @tr("ui" => "Your saved login stays locked in Windows Credential Manager. Approve Windows Hello after SSH host verification."); color: GlassTheme.muted; wrap: word-wrap; font-size: 13px; }
                    if !root.use-saved : VerticalLayout {
                        spacing: 9px;
                        LineEdit { text <=> root.username; placeholder-text: @tr("ui" => "Mac account short username"); enabled: !root.connecting; accessible-label: @tr("ui" => "SSH Mac username"); }
                        LineEdit { text <=> root.password; placeholder-text: @tr("ui" => "Mac account password"); input-type: InputType.password; enabled: !root.connecting; accessible-label: @tr("ui" => "SSH Mac password"); }
                        Text { text: @tr("ui" => "This password is used only for this SSH connection and is not saved."); color: GlassTheme.muted; wrap: word-wrap; font-size: 11px; }
                    }
                    HorizontalLayout {
                        Button { text: UiText.message(root.connecting ? @tr("ui" => "Verifying SSH...") : @tr("ui" => "Connect securely")); primary: true; enabled: !root.connecting; clicked => { root.connect(); } }
                        if root.connecting : Button { text: @tr("ui" => "Cancel"); clicked => { root.disconnect(); } }
                    }
                    Rectangle { background: transparent; vertical-stretch: 1; }
                }
                if !root.clipboard-view && root.connected && !root.key-pending : VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        Button { text: @tr("ui" => "Up"); enabled: !root.busy && root.directory-ready; clicked => { root.up(); } }
                        LineEdit { text <=> root.path; enabled: !root.busy; accessible-label: @tr("ui" => "Mac folder"); accepted => { root.browse(); } }
                        Button { text: @tr("ui" => "Go"); enabled: !root.busy; clicked => { root.browse(); } }
                        Button { text: @tr("ui" => "Disconnect SSH"); enabled: !root.busy; clicked => { root.disconnect(); } }
                    }
                    ScrollView {
                        preferred-height: 220px; min-height: 100px; max-height: 220px; vertical-stretch: 0;
                        VerticalLayout {
                            spacing: 6px; padding-right: 8px;
                            if root.entries.length == 0 : Text { text: UiText.message(root.directory-ready ? @tr("ui" => "This folder is empty.") : @tr("ui" => "Enter a Mac folder path to browse.")); color: GlassTheme.muted; font-size: 13px; }
                            for file[index] in root.entries : GlassPanel {
                                radius: 12px; height: 58px;
                                accessible-role: groupbox; accessible-label: (file.directory ? @tr("ui" => "Mac folder ") : @tr("ui" => "Mac item ")) + file.name;
                                HorizontalLayout {
                                    padding: 9px; spacing: 10px;
                                    VerticalLayout {
                                        spacing: 1px; alignment: center; horizontal-stretch: 1;
                                        Text { text: file.name; color: GlassTheme.ink; font-size: 13px; overflow: elide; }
                                        Text { text: file.detail; color: GlassTheme.muted; font-size: 11px; }
                                    }
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 0;
                                        Button { preferred-width: 100px; vertical-stretch: 0; text: file.directory ? @tr("ui" => "Open") : (file.regular ? @tr("ui" => "Receive") : @tr("ui" => "Not a file")); accessible-label: (file.directory ? @tr("ui" => "Open ") : @tr("ui" => "Receive ")) + file.name; enabled: !root.busy && (file.directory || file.regular); clicked => { root.entry(index); } }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        LineEdit { text <=> root.upload-name; placeholder-text: @tr("ui" => "Optional new file name on the Mac"); enabled: !root.busy && root.directory-ready; accessible-label: @tr("ui" => "Upload file name"); }
                        Button { text: @tr("ui" => "Send a file..."); primary: true; enabled: !root.busy && root.directory-ready; clicked => { root.upload(); } }
                    }
                    Text { text: @tr("ui" => "Single files only. Existing files are never replaced. Uploads are verified by reading them back before the final file is created."); color: GlassTheme.muted; wrap: word-wrap; font-size: 11px; }
                }
                    if root.connected && root.busy : VerticalLayout {
                        spacing: 6px;
                        Rectangle { height: 4px; background: GlassTheme.edge; border-radius: 2px; Rectangle { width: parent.width * root.progress; background: GlassTheme.accent; border-radius: 2px; } }
                        HorizontalLayout {
                            Text { text: UiText.message(root.progress-label); color: GlassTheme.ink; font-size: 12px; wrap: word-wrap; }
                            Button { text: @tr("ui" => "Cancel operation"); clicked => { root.cancel(); } }
                        }
                    }
                }
                }
                Text { text: UiText.message(root.status); color: GlassTheme.muted; font-size: 12px; wrap: word-wrap; }
            }
        }
    }
}

export component FilesOverlay inherits SshSharingOverlay { }
