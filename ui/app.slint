import { UiText, Branding } from "i18n.slint";
export { UiText, Branding } from "i18n.slint";
import { LineEdit, ComboBox, ScrollView, Palette } from "std-widgets.slint";
import { GlassTheme, GlassPanel, Button, CheckBox, Slider } from "glass.slint";
import { AboutOverlay } from "about.slint";
import { ClipboardOverlay } from "clipboard.slint";
import { NativeFilesOverlay } from "native-files.slint";
import { AudioOverlay } from "audio.slint";
import { FilesOverlay, FileRow } from "files.slint";

export struct Machine { id: string, name: string, detail: string, saved: bool, login: string, protection: string }
export struct TrafficBar { download: float, upload: float }
export struct CodecGuide { name: string, detail: string, estimate: string }

component Caption inherits Text {
    color: Palette.foreground;
    font-size: 12px;
    font-weight: 600;
    height: 20px;
    vertical-alignment: center;
}

component TrafficPlot inherits Rectangle {
    in property <[TrafficBar]> samples;
    in property <color> incoming: GlassTheme.accent;
    in property <color> outgoing: #8e8e93;
    in property <bool> motion: true;
    background: transparent;
    HorizontalLayout {
        spacing: 1px;
        for sample in root.samples : Rectangle {
            background: transparent;
            Rectangle {
                x: 0px; width: parent.width / 2;
                height: max(1px, sample.download * (parent.height - 2px));
                y: parent.height - self.height;
                background: root.incoming;
                opacity: sample.download > 0 ? 1 : 0.15;
                animate height, opacity { duration: root.motion ? 220ms : 0ms; easing: ease-out; }
            }
            Rectangle {
                x: parent.width / 2; width: parent.width / 2;
                height: max(1px, sample.upload * (parent.height - 2px));
                y: parent.height - self.height;
                background: root.outgoing;
                opacity: sample.upload > 0 ? 1 : 0.15;
                animate height, opacity { duration: root.motion ? 220ms : 0ms; easing: ease-out; }
            }
        }
    }
}

export component App inherits Window {
    title: Branding.display-name;
    icon: @image-url("../assets/brand/sovelyx-desk.png");
    preferred-width: 1000px;
    preferred-height: 680px;
    min-width: 760px;
    min-height: 560px;
    default-font-family: UiText.chinese ? "Microsoft YaHei UI" : "Segoe UI";
    default-font-size: 14px;

    in-out property <string> machine-name;
    in-out property <string> host;
    in-out property <string> port: "5900";
    in-out property <string> username;
    in-out property <string> password;
    in-out property <int> auth-mode: 0;
    in-out property <bool> remember-password: false;
    in-out property <bool> use-saved: false;
    in property <bool> has-saved: false;
    in-out property <bool> ctrl-as-command: true;
    in property <bool> dark-theme: false;
    in property <bool> motion-enabled: true;
    in property <bool> glass-enabled: true;
    in-out property <bool> sidebar-open: true;
    in-out property <bool> editor-open: false;
    in-out property <int> credential-mode: 2;
    in-out property <bool> credential-approved: false;
    in-out property <bool> auto-reconnect: true;
    in-out property <bool> delete-credentials: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> show-fps: true;
    in-out property <string> machine-filter;
    in property <[Machine]> machines;
    in property <int> machine-count;
    private property <length> single-card-height: 184px;
    in property <int> selected: -1;
    in property <bool> connected: false;
    in property <bool> connecting: false;
    in property <bool> immersive: false;
    in property <bool> pulse: false;
    in property <string> app-version;
    in property <string> build-date;
    in property <string> build-revision;
    in property <string> build-target;
    in property <string> build-compiler;
    in property <string> author-name;
    in property <string> log-path;
    in property <string> audit-error;
    in-out property <bool> about-open: false;
    in-out property <bool> clipboard-open: false;
    in-out property <bool> clipboard-shared: false;
    in-out property <bool> auto-clipboard-enabled: false;
    in-out property <bool> auto-clipboard-to-mac: true;
    in-out property <bool> auto-clipboard-to-windows: true;
    in-out property <string> auto-clipboard-limit: "1048576";
    in property <string> auto-clipboard-status: @tr("ui" => "Paused — automatic sharing is off");
    callback auto-clipboard-changed();
    in-out property <bool> native-files-open: false;
    in-out property <string> native-file-destination;
    in-out property <string> native-file-source;
    in property <string> native-file-result;
    in property <bool> native-file-busy: false;
    callback native-file-upload(bool);
    callback native-file-download();
    callback native-file-cancel();
    in-out property <bool> native-clipboard-enabled: false;
    in-out property <bool> native-clipboard-receive: true;
    in-out property <bool> native-clipboard-send: true;
    in-out property <bool> native-clipboard-files: false;
    in property <string> native-clipboard-status: @tr("ui" => "Experimental Apple clipboard — disabled");
    callback native-clipboard-changed();
    in property <string> clipboard-mode: @tr("ui" => "Standard VNC: Latin-1 compatibility mode.");
    in-out property <bool> files-open: false;
    in property <string> files-host;
    in-out property <string> files-port: "22";
    in-out property <string> files-username;
    in-out property <string> files-password;
    in property <bool> files-has-saved;
    in-out property <bool> files-use-saved;
    in property <bool> files-connected;
    in property <bool> hevc-active;
    in-out property <bool> audio-open: false;
    in-out property <bool> audio-muted: false;
    in-out property <float> audio-volume: 100;
    in property <bool> audio-codec-missing: false;
    in property <bool> audio-installing: false;
    in property <string> audio-status: @tr("ui" => "Audio is available with HEVC.");
    in property <bool> files-directory-ready;
    in property <bool> files-connecting;
    in property <bool> files-busy;
    in property <bool> files-key-pending;
    in property <string> files-fingerprint;
    in property <string> files-key-algorithm;
    in property <string> files-key-command;
    in-out property <string> files-path;
    in-out property <string> files-upload-name;
    in property <[FileRow]> file-entries;
    in property <string> files-status;
    in property <string> files-error;
    in property <string> files-progress-label;
    in property <float> files-progress;
    out property <bool> modal-open: licenses-open || display-open || native-files-open || editor-open || settings-open || quality-open || help-open || about-open || clipboard-open || files-open || audio-open || update-installing;
    out property <bool> canvas-focused: remote-focus.has-focus;
    in property <bool> update-checking: false;
    in property <bool> update-available: false;
    in property <bool> update-installing: false;
    in property <bool> update-restart-required: false;
    in property <bool> update-banner: false;
    in property <string> update-status: @tr("ui" => "Checking for updates on launch...");
    in property <string> update-version;
    in property <float> update-progress;
    in property <string> status: @tr("ui" => "Ready to connect");
    in-out property <string> error-text;
    in property <string> desktop-description;
    in property <image> frame-image;
    in property <float> draw-left;
    in property <float> draw-top;
    in property <float> draw-width;
    in property <float> draw-height;
    in property <string> download-rate: @tr("ui" => "0.0 kbps");
    in property <string> upload-rate: @tr("ui" => "0.0 kbps");
    in property <string> fps-text: @tr("ui" => "0 FPS");
    in property <[TrafficBar]> traffic;
    in property <string> active-encoding: @tr("ui" => "Waiting for pixels");
    in-out property <int> encoding-index: 0;
    in-out property <float> compression-level: 6;
    in-out property <float> jpeg-quality: 8;
    in-out property <bool> manual-bandwidth: false;
    in-out property <string> target-mbps: "10";
    in-out property <bool> manual-hevc-bitrate: false;
    in-out property <string> hevc-mbps: "60";
    in-out property <string> max-fps: "60";
    in property <string> encoding-description;
    in property <string> bandwidth-description: @tr("ui" => "Default: HEVC / H.265, adaptive bitrate, up to 60 FPS.");
    in property <[CodecGuide]> codec-guide;
    in property <string> estimate-context;
    in-out property <int> language-index: 0;
    callback language-changed(int);
    in-out property <bool> licenses-open: false;
    in property <string> license-text;
    callback show-licenses();
    in property <bool> brand-updates-ready: false;
    in-out property <bool> quality-open: false;
    in-out property <bool> display-open: false;
    in-out property <int> display-mode: 0;
    in property <bool> display-can-pan: false;
    in-out property <bool> pan-view: false;
    callback display-mode-changed(int);
    callback pan-step(float, float);
    callback pan-pointer(float, float, PointerEvent);
    in-out property <bool> help-open: false;
    in-out property <bool> confirm-delete: false;
    out property <float> canvas-width: canvas.width / 1px;
    out property <float> canvas-height: canvas.height / 1px;
    in property <image> remote-cursor-image;
    in property <bool> remote-cursor-ready: false;
    in property <bool> remote-cursor-hidden: false;
    in property <float> remote-cursor-width;
    in property <float> remote-cursor-height;
    in property <float> remote-cursor-hotspot-x;
    in property <float> remote-cursor-hotspot-y;
    in property <float> remote-cursor-scale: 1;
    in property <float> remote-cursor-frame-width: 1;
    private property <float> remote-cursor-zoom: Math.min(4, Math.max(0.125, root.remote-cursor-scale * root.draw-width / Math.max(1, root.remote-cursor-frame-width)));

    callback connect-requested();
    callback disconnect-requested();
    callback save-machine();
    callback new-machine();
    callback delete-machine();
    callback select-machine(string);
    callback quick-connect(string);
    callback filter-machines();
    callback save-preferences();
    callback quality-changed();
    callback apply-streaming();
    callback audio-changed();
    callback audio-install();
    callback audio-retry();
    callback reset-streaming();
    callback refresh-desktop();
    callback fullscreen-requested();
    callback canvas-resized();
    callback video-frame-ready();
    callback pointer-event(float, float, PointerEvent);
    callback wheel-event(float, float, PointerScrollEvent);
    callback keyboard-event(KeyEvent, bool) -> bool;
    callback release-input();
    callback focus-canvas();
    callback check-updates();
    callback install-update();
    callback dismiss-update();
    callback about-link(int);
    callback open-logs();
    callback clipboard-changed();
    callback paste-windows-text();
    callback open-clipboard();
    callback close-clipboard();
    callback open-files();
    callback files-close();
    callback files-connect();
    callback files-disconnect();
    callback files-approve(bool);
    callback files-browse();
    callback files-up();
    callback files-entry(int);
    callback files-upload();
    callback files-cancel();
    callback files-copy-text();
    callback files-send-text();

    init => {
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
        GlassTheme.dark = root.dark-theme;
        GlassTheme.motion = root.motion-enabled;
        GlassTheme.effects = root.glass-enabled;
    }
    changed dark-theme => {
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
        GlassTheme.dark = root.dark-theme;
    }
    changed motion-enabled => { GlassTheme.motion = root.motion-enabled; }
    changed glass-enabled => { GlassTheme.effects = root.glass-enabled; }
    changed pan-view => { root.release-input(); }
    changed canvas-width => { root.canvas-resized(); }
    changed canvas-height => { root.canvas-resized(); }
    changed encoding-index => { root.quality-changed(); }
    changed machine-filter => { root.filter-machines(); }
    changed use-saved => { root.username = ""; root.password = ""; }
    changed files-use-saved => { root.files-username = ""; root.files-password = ""; }
    focus-canvas => { remote-focus.focus(); }

    background: root.dark-theme ? #000000 : #f2f2f7;
    property <color> panel: root.dark-theme ? #1c1c1e : #ffffff;
    property <color> outline: root.dark-theme ? #48484a : #d1d1d6;
    property <color> muted: GlassTheme.muted;
    property <color> ink: GlassTheme.ink;
    property <color> accent: GlassTheme.accent;
    property <color> selection: root.dark-theme ? #0a84ff1f : #007aff0c;
    FocusScope {
        enabled: !root.modal-open;
    VerticalLayout {
        spacing: root.immersive ? 0px : 12px;
        padding: root.immersive ? 0px : 12px;
        if !root.immersive : GlassPanel {
            height: 60px;
            radius: 20px;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px;
                padding-top: 10px; padding-bottom: 10px; spacing: 8px;
                if root.connected : Button {
                    accessible-label: @tr("ui" => "Toggle connections sidebar");
                    icon: @image-url("../assets/sidebar.svg"); quiet: !root.sidebar-open;
                    clicked => { root.sidebar-open = !root.sidebar-open; root.save-preferences(); }
                }
                Image { source: @image-url("../assets/brand/sovelyx-desk.png"); width: 32px; height: 32px; }
                if !root.connected : VerticalLayout {
                    spacing: 0px;
                    Text { text: UiText.message(Branding.display-name); color: root.ink; font-size: 19px; font-weight: 700; }
                    if !root.connected : Text { text: UiText.message(Branding.slogan); color: root.muted; font-size: 11px; }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                if root.connected : Button { text: @tr("ui" => "Quality"); icon: @image-url("../assets/tune.svg"); accessible-label: @tr("ui" => "Stream quality"); clicked => { root.quality-open = true; root.release-input(); } }
                if root.connected : Button { text: @tr("ui" => "Display"); accessible-label: @tr("ui" => "Display scaling"); clicked => { root.release-input(); root.display-open = true; } }
                if root.connected : Button { icon: @image-url("../assets/audio.svg"); accessible-label: @tr("ui" => "Audio playback"); quiet: root.audio-muted; clicked => { root.audio-open = true; root.release-input(); } }
                if root.connected : Button { icon: @image-url("../assets/clipboard.svg"); accessible-label: @tr("ui" => "Clipboard sharing"); quiet: true; clicked => { root.open-clipboard(); } }
                if root.connected : Button { icon: @image-url("../assets/folder.svg"); accessible-label: @tr("ui" => "File transfer"); quiet: !root.files-connected; clicked => { root.open-files(); } }
                if root.connected : Button { accessible-label: @tr("ui" => "Refresh"); icon: @image-url("../assets/refresh.svg"); quiet: true; clicked => { root.refresh-desktop(); } }
                if root.connected : Button { accessible-label: @tr("ui" => "Full screen"); icon: @image-url("../assets/fullscreen.svg"); quiet: true; clicked => { root.fullscreen-requested(); } }
                Button { text: UiText.message(root.connected ? "" : @tr("ui" => "Settings")); icon: @image-url("../assets/tune.svg"); accessible-label: @tr("ui" => "Settings"); quiet: true; clicked => { root.settings-open = true; root.release-input(); } }
                Button { icon: @image-url("../assets/info.svg"); accessible-label: @tr("ui" => "About"); quiet: true; clicked => { root.about-open = true; root.release-input(); } }
                if root.connected || root.connecting : Button { text: UiText.message(root.connecting ? @tr("ui" => "Cancel") : @tr("ui" => "Disconnect")); clicked => { root.disconnect-requested(); } }
            }
        }
        HorizontalLayout {
            padding-left: 0px; padding-right: 0px; padding-top: 0px;
            spacing: root.sidebar-open && !root.immersive && root.connected ? 14px : 0px;
            sidebar := Rectangle {
                preferred-width: 320px;
                min-width: root.connected ? (root.sidebar-open && !root.immersive ? 320px : 0px) : 0px;
                max-width: root.connected ? (root.sidebar-open && !root.immersive ? 320px : 0px) : 100000px;
                horizontal-stretch: root.connected ? 0 : 1;
                border-radius: 20px;
                clip: true;
                background: transparent;
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: root.connected ? root.panel : transparent;
                    border-radius: sidebar.border-radius;
                    opacity: min(1, sidebar.width / 240px);
                    visible: sidebar.width > 1px;
                    manager := Rectangle {
                        x: (parent.width - self.width) / 2;
                        width: min(root.machine-count == 1 ? 460px : (root.machine-count == 2 ? 776px : 1172px), parent.width - (root.connected ? 24px : 48px));
                        height: parent.height;
                        background: transparent;
                        VerticalLayout {
                            y: !root.connected && root.machine-count > 0 && root.machine-count <= 3 ? max(24px, (parent.height - (root.machine-count == 1 ? 286px : (manager.width >= 1032px || (root.machine-count == 2 && manager.width >= 688px) ? 286px : 496px))) * 0.42) : 24px;
                            height: parent.height - self.y - 24px;
                            spacing: 16px;
                            if root.machine-count > 0 : HorizontalLayout {
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: UiText.message(root.machine-count == 1 ? @tr("ui" => "Your Mac") : @tr("ui" => "My Macs")); color: root.ink; font-size: 24px; font-weight: 600; }
                                    if root.machine-count > 1 : Text { text: UiText.message(root.machine-count + @tr("ui" => " saved Macs")); color: root.muted; font-size: 12px; }
                                }
                                Rectangle { background: transparent; horizontal-stretch: 1; }
                                if root.machine-count > 1 : Button {
                                    text: @tr("ui" => "+ Add Mac"); accessible-label: @tr("ui" => "New connection");
                                    enabled: !root.connected && !root.connecting;
                                    clicked => { root.new-machine(); }
                                }
                            }
                            if root.error-text != "" : VerticalLayout {
                                spacing: 8px;
                                Text { text: UiText.message(root.error-text); color: root.ink; wrap: word-wrap; }
                                HorizontalLayout {
                                    alignment: start; spacing: 8px;
                                    Button { text: @tr("ui" => "Update Password"); enabled: root.selected >= 0 && !root.connected && !root.connecting; clicked => { root.editor-open = true; root.use-saved = false; root.password = ""; } }
                                    Button { text: @tr("ui" => "Dismiss"); quiet: true; clicked => { root.error-text = ""; } }
                                }
                            }
                            if root.machine-count >= 4 : HorizontalLayout {
                                alignment: start; spacing: 8px;
                                LineEdit { accessible-label: @tr("ui" => "Search saved Macs"); width: min(320px, manager.width - 80px); height: 36px; text <=> root.machine-filter; placeholder-text: @tr("ui" => "Search by name or address"); }
                                if root.machine-filter != "" : Button { text: @tr("ui" => "Clear"); accessible-label: @tr("ui" => "Clear search"); quiet: true; clicked => { root.machine-filter = ""; } }
                            }
                            if root.machine-count == 0 : VerticalLayout {
                                alignment: center; spacing: 16px;
                                Rectangle { height: 64px; background: transparent; Image { source: @image-url("../assets/logo-mark.svg"); width: 64px; height: 64px; x: (parent.width - self.width) / 2; } }
                                Text { text: @tr("ui" => "Your Macs, one click away."); color: root.ink; font-size: 22px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: @tr("ui" => "Add your first Mac to get started."); color: root.muted; horizontal-alignment: center; }
                                HorizontalLayout { alignment: center; Button { text: @tr("ui" => "Add Your First Mac"); accessible-label: @tr("ui" => "New connection"); primary: true; clicked => { root.new-machine(); } } }
                            }
                            if root.machine-count > 0 && root.machines.length == 0 : VerticalLayout {
                                alignment: start; spacing: 12px;
                                Text { text: @tr("ui" => "No Macs match this search."); color: root.ink; font-size: 16px; }
                                Text { text: @tr("ui" => "Try another name or address. Your saved Macs are still here."); color: root.muted; wrap: word-wrap; }
                            }
                            if root.machines.length > 0 : grid := ScrollView {
                                private property <int> columns: min(root.machines.length, manager.width >= 1032px ? 3 : (manager.width >= 688px ? 2 : 1));
                                private property <length> card-width: root.machine-count == 1 ? min(460px, self.visible-width) : min(380px, (self.visible-width - (self.columns - 1) * 16px) / self.columns);
                                private property <length> grid-width: self.columns * self.card-width + (self.columns - 1) * 16px;
                                vertical-stretch: root.machine-count <= 3 ? 0 : 1;
                                max-height: root.machine-count == 1 ? root.single-card-height + 8px : (root.machine-count <= 3 ? ceil(root.machines.length / self.columns) * 200px : 100000px);
                                min-height: root.machine-count == 1 ? root.single-card-height + 8px : (root.machine-count <= 3 ? min(ceil(root.machines.length / self.columns) * 200px, manager.height - 180px) : 0px);
                                horizontal-scrollbar-policy: always-off;
                                vertical-scrollbar-policy: root.machine-count <= 3 ? always-off : as-needed;
                                content-width: self.visible-width;
                                content-height: root.machine-count == 1 ? root.single-card-height + 4px : ceil(root.machines.length / self.columns) * 200px - 12px;
                                for machine[index] in root.machines : GlassPanel {
                                    x: (grid.visible-width - grid.grid-width) / 2 + mod(index, grid.columns) * (grid.card-width + 16px);
                                    y: 2px + floor(index / grid.columns) * 200px;
                                    width: grid.card-width; height: root.single-card-height; radius: 14px;
                                    accessible-role: groupbox; accessible-label: @tr("ui" => "Mac: ") + machine.name;
                                    background: root.selected == index ? root.selection : (card-hover.has-hover ? (root.dark-theme ? #242426 : #fafcff) : root.panel);
                                    border-color: root.selected == index || card-connect.focused || card-menu.focused ? root.accent : (card-hover.has-hover ? root.muted : GlassTheme.edge);
                                    animate background, border-color { duration: root.motion-enabled ? 120ms : 0ms; }
                                    card-hover := TouchArea { }
                                    VerticalLayout {
                                        padding: 18px; spacing: 10px;
                                        HorizontalLayout {
                                            height: 44px; spacing: 12px;
                                            Image { source: @image-url("../assets/mac-display.svg"); width: 32px; height: 32px; colorize: root.ink; }
                                            VerticalLayout {
                                                spacing: 4px; horizontal-stretch: 1;
                                                Text { text: machine.name; color: root.ink; font-size: 18px; font-weight: 600; overflow: elide; min-width: 0px; }
                                                Text { text: UiText.message(machine.detail); color: root.muted; font-size: 13px; overflow: elide; min-width: 0px; }
                                            }
                                            card-menu := Button {
                                                text: "···"; accessible-label: @tr("ui" => "More actions for ") + machine.name; quiet: true; width: 36px; enabled: !root.connected && !root.connecting;
                                                clicked => { device-menu.show(); }
                                                device-menu := PopupWindow {
                                                    x: parent.width - self.width; y: parent.height + 4px;
                                                    width: 190px; height: 144px;
                                                    GlassPanel {
                                                        radius: 12px;
                                                        VerticalLayout {
                                                            padding: 8px; spacing: 4px;
                                                            Button { text: @tr("ui" => "Edit Mac"); quiet: true; clicked => { device-menu.close(); root.select-machine(machine.id); } }
                                                            Button { text: @tr("ui" => "Update Password"); quiet: true; clicked => { device-menu.close(); root.select-machine(machine.id); root.use-saved = false; root.password = ""; } }
                                                            Button { text: @tr("ui" => "Remove Mac…"); quiet: true; clicked => { device-menu.close(); root.select-machine(machine.id); root.confirm-delete = true; } }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            height: 18px; alignment: start; spacing: 8px;
                                            Text { text: UiText.message(machine.login); color: root.ink; font-size: 13px; font-weight: 500; }
                                            Text { text: "·"; color: root.muted; font-size: 13px; }
                                            Text { text: UiText.message(machine.protection); color: root.muted; font-size: 13px; overflow: elide; min-width: 0px; }
                                        }
                                        Rectangle { background: transparent; vertical-stretch: 1; }
                                        Rectangle { height: 1px; background: root.outline; opacity: 0.5; }
                                        HorizontalLayout {
                                            height: 36px; spacing: 12px;
                                            Text {
                                                text: UiText.message(root.selected == index && root.connected ? @tr("ui" => "Connected") : (root.selected == index && root.connecting ? root.status : (root.selected == index && root.status == @tr("ui" => "Connection failed") ? @tr("ui" => "Connection failed") : (machine.saved ? @tr("ui" => "Password saved") : @tr("ui" => "Password required")))));
                                                accessible-label: @tr("ui" => "Credential and connection status: ") + self.text;
                                                color: root.selected == index && root.status == @tr("ui" => "Connection failed") && !root.connected && !root.connecting ? (root.dark-theme ? #ff6961 : #b42318) : (root.selected == index && root.connected ? (root.dark-theme ? #62d38b : #157a3b) : root.muted);
                                                font-size: 13px; font-weight: 500; vertical-alignment: center;
                                                horizontal-stretch: 1; min-width: 0px; overflow: elide;
                                            }
                                            card-connect := Button {
                                                text: UiText.message(root.selected == index && root.connected ? @tr("ui" => "Connected") : (root.selected == index && root.connecting ? @tr("ui" => "Connecting…") : (root.selected == index && root.status == @tr("ui" => "Connection failed") ? @tr("ui" => "Retry") : @tr("ui" => "Connect"))));
                                                accessible-label: self.text + @tr("ui" => " to ") + machine.name;
                                                width: root.machine-count == 1 ? 148px : 124px;
                                                primary: !(root.selected == index && root.connected);
                                                enabled: !root.connected && !root.connecting;
                                                clicked => { root.quick-connect(machine.id); }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.machine-count == 1 : HorizontalLayout {
                                alignment: center;
                                Button { text: @tr("ui" => "+ Add another Mac"); accessible-label: @tr("ui" => "New connection"); quiet: true; enabled: !root.connected && !root.connecting; clicked => { root.new-machine(); } }
                            }
                            if root.machine-count > 0 && root.machine-count <= 3 : Rectangle { background: transparent; vertical-stretch: 1; }
                        }
                    }
                }
            }
            Rectangle {
                min-width: 0px;
                max-width: root.connected ? 100000px : 0px;
                visible: root.connected;
                horizontal-stretch: 1;
            VerticalLayout {
                spacing: 10px;
                if root.audit-error != "" : Rectangle {
                    background: root.dark-theme ? #ff453a19 : #ff3b3010;
                    border-radius: 8px; min-height: 60px;
                    Text { x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px; text: UiText.message(root.audit-error); color: root.ink; wrap: word-wrap; font-size: 12px; }
                }

                canvas := Rectangle {
                    accessible-role: groupbox; accessible-label: @tr("ui" => "Remote desktop");
                    vertical-stretch: 1; horizontal-stretch: 1;
                    border-radius: root.immersive ? 0px : 20px;
                    border-width: root.immersive ? 0px : 1px;
                    border-color: GlassTheme.edge;
                    background: root.connected || root.immersive ? #000000 : (root.dark-theme ? #111111c9 : #ffffffd9); clip: true;
                    if !root.connected : VerticalLayout {
                        alignment: center; padding: 30px; spacing: 14px;
                        Rectangle {
                            height: 92px; background: transparent;
                            Image { source: @image-url("../assets/brand/sovelyx-desk.png"); width: 92px; height: 92px; x: (parent.width - self.width) / 2; }
                        }
                        Text { text: UiText.message(root.connecting ? @tr("ui" => "A moment closer.") : @tr("ui" => "Your Mac, beautifully in view.")); color: root.ink; font-size: 27px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
                        Text { text: UiText.message(root.connecting ? @tr("ui" => "Verify with Windows Hello if prompted.") : @tr("ui" => "Choose a saved Mac or add a new connection.")); color: root.muted; horizontal-alignment: center; wrap: word-wrap; }
                        HorizontalLayout {
                            alignment: center;
                            Button { width: 200px; text: @tr("ui" => "New connection"); primary: true; enabled: !root.connecting; clicked => { root.new-machine(); root.sidebar-open = true; } }
                        }
                        Text { text: @tr("ui" => "Sharp scaling. A familiar cursor. Your whole desktop."); color: root.muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                    }
                    if root.connected : Image {
                        x: root.draw-left * 1px; y: root.draw-top * 1px;
                        width: root.draw-width * 1px; height: root.draw-height * 1px;
                        source: root.frame-image; image-fit: fill;
                    }
                    remote-focus := FocusScope {
                        enabled: root.connected && !root.modal-open;
                        key-pressed(event) => { return root.keyboard-event(event, true) ? EventResult.accept : EventResult.reject; }
                        key-released(event) => { return root.keyboard-event(event, false) ? EventResult.accept : EventResult.reject; }
                        changed has-focus => { if !self.has-focus { root.release-input(); } }
                        remote-pointer := TouchArea {
                            private property <bool> over-video: self.mouse-x >= root.draw-left * 1px && self.mouse-y >= root.draw-top * 1px && self.mouse-x < (root.draw-left + root.draw-width) * 1px && self.mouse-y < (root.draw-top + root.draw-height) * 1px;
                            enabled: root.connected;
                            mouse-cursor: !root.pan-view && self.over-video && (root.remote-cursor-ready || root.remote-cursor-hidden) ? MouseCursor.none : MouseCursor.default;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down { remote-focus.focus(); }
                                if root.pan-view { root.pan-pointer(self.mouse-x / 1px, self.mouse-y / 1px, event); }
                                else { root.pointer-event(self.mouse-x / 1px, self.mouse-y / 1px, event); }
                            }
                            scroll-event(event) => { if !root.pan-view { root.wheel-event(self.mouse-x / 1px, self.mouse-y / 1px, event); } return EventResult.accept; }
                        }
                    }
                    if root.connected && !root.modal-open && !root.pan-view && root.remote-cursor-ready && remote-pointer.has-hover && remote-pointer.over-video : Image {
                        source: root.remote-cursor-image;
                        x: remote-pointer.mouse-x - root.remote-cursor-hotspot-x * root.remote-cursor-zoom * 1px;
                        y: remote-pointer.mouse-y - root.remote-cursor-hotspot-y * root.remote-cursor-zoom * 1px;
                        width: root.remote-cursor-width * root.remote-cursor-zoom * 1px;
                        height: root.remote-cursor-height * root.remote-cursor-zoom * 1px;
                    }
                    if root.immersive : Rectangle {
                        x: 12px; y: 12px; width: 310px; height: 40px;
                        border-radius: 10px; background: #1c1c1ee8;
                        HorizontalLayout {
                            padding: 10px; spacing: 10px;
                            Text { text: UiText.message(root.download-rate + @tr("ui" => " in")); color: #64aaff; font-size: 12px; vertical-alignment: center; }
                            TrafficPlot { width: 78px; samples: root.traffic; motion: root.motion-enabled; }
                            if root.show-fps : Text { text: UiText.message(root.fps-text); color: #ffffff; font-size: 12px; vertical-alignment: center; }
                        }
                    }
                    if root.immersive : Button {
                        x: parent.width - 280px; y: 12px; width: 100px; height: 32px;
                        text: @tr("ui" => "Display"); accessible-label: @tr("ui" => "Display scaling");
                        clicked => { root.release-input(); root.display-open = true; }
                    }
                    if root.pan-view : Button {
                        x: 12px; y: parent.height - 48px; width: 220px; height: 36px;
                        text: @tr("ui" => "Pan on · Stop panning"); accessible-label: @tr("ui" => "Stop local panning"); primary: true;
                        clicked => { root.pan-view = false; }
                    }
                    if root.immersive : Button {
                        x: parent.width - self.width - 12px; y: 12px;
                        width: 156px; height: 32px; text: @tr("ui" => "Exit full screen");
                        clicked => { root.fullscreen-requested(); }
                    }
                }

            }
            }

        }
        if !root.immersive : GlassPanel {
            height: 34px; radius: 12px;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px; padding-top: 6px; padding-bottom: 6px; spacing: 12px;
                Rectangle {
                    width: 12px;
                    background: transparent;
                    Rectangle {
                        accessible-role: text; accessible-label: @tr("ui" => "Connection status indicator");
                        width: 8px; height: 8px; x: 2px; y: (parent.height - self.height) / 2;
                        border-radius: 4px; background: root.connected ? #30d158 : (root.connecting ? #ff9f0a : #8e8e93);
                        opacity: root.connecting && root.pulse ? 0.4 : 1;
                        animate opacity { duration: root.motion-enabled ? 500ms : 0ms; }
                    }
                }
                Text { text: UiText.message(root.status); color: root.ink; font-size: 12px; min-width: 0px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                if root.connected : Text { max-width: 180px; min-width: 0px; text: UiText.message(root.active-encoding); color: root.muted; font-size: 12px; vertical-alignment: center; overflow: elide; }
                if root.connected : Text { text: UiText.message(@tr("ui" => "IN ") + root.download-rate + @tr("ui" => "   OUT ") + root.upload-rate); color: root.muted; font-size: 12px; vertical-alignment: center; }
                if root.connected && root.show-fps : Text { accessible-label: @tr("ui" => "Live FPS: ") + root.fps-text; text: UiText.message(root.fps-text); color: root.ink; font-family: "Consolas"; font-size: 12px; vertical-alignment: center; }
                if !root.connected : Text { text: UiText.message(@tr("ui" => "v") + root.app-version); color: root.muted; font-size: 11px; vertical-alignment: center; }
            }
        }
    }
    }

    if root.editor-open : Rectangle {
        background: #00000055;
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => { if event.text == Key.Escape && !root.connecting { root.editor-open = false; root.password = ""; return accept; } return reject; }
        GlassPanel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(580px, parent.width - 48px); height: min(740px, parent.height - 48px);
            background: root.panel; raised: true;
            VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    Text { text: UiText.message(root.selected >= 0 ? @tr("ui" => "Edit Mac connection") : @tr("ui" => "Add a Mac")); color: root.ink; font-size: 22px; font-weight: 600; }
                    Rectangle { background: transparent; horizontal-stretch: 1; }
                    Button { width: 88px; text: @tr("ui" => "Cancel"); accessible-label: @tr("ui" => "Close connection editor"); clicked => { root.editor-open = false; root.password = ""; } }
                }
                if root.error-text != "" : Text { text: UiText.message(root.error-text); color: root.ink; wrap: word-wrap; }
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    VerticalLayout { spacing: 8px;
                                if root.connected : Text { text: @tr("ui" => "Disconnect before changing this Mac's details."); color: root.muted; wrap: word-wrap; }
                                Caption { text: @tr("ui" => "BASIC INFORMATION"); color: root.muted; }
                                Caption { text: @tr("ui" => "Device name"); }
                                LineEdit { height: 36px; accessible-label: @tr("ui" => "Machine name"); text <=> root.machine-name; placeholder-text: @tr("ui" => "Mac mini"); enabled: !root.connected && !root.connecting; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        spacing: 6px; horizontal-stretch: 1;
                                        Caption { text: @tr("ui" => "Host or IP address"); }
                                        LineEdit { height: 36px; accessible-label: @tr("ui" => "Mac address"); text <=> root.host; edited => {root.use-saved = false; root.password = ""; root.credential-approved = false;} placeholder-text: "192.168.1.50"; enabled: !root.connected && !root.connecting; }
                                    }
                                    VerticalLayout {
                                        width: 104px; spacing: 6px;
                                        Caption { text: @tr("ui" => "Port"); }
                                        LineEdit { height: 36px; accessible-label: @tr("ui" => "VNC port"); text <=> root.port; edited => {root.use-saved = false; root.password = ""; root.credential-approved = false;} input-type: InputType.number; enabled: !root.connected && !root.connecting; }
                                    }
                                }
                                Caption { text: @tr("ui" => "Login method"); }
                                ComboBox {
                                    accessible-label: @tr("ui" => "Login method"); model: [@tr("ui" => "Mac account"), @tr("ui" => "VNC password")];
                                    current-index <=> root.auth-mode; enabled: !root.connected && !root.connecting;
                                    selected => {root.use-saved = false;root.username = "";root.password = "";root.credential-approved = false;}
                                }
                                if root.auth-mode == 1 : Text {text: @tr("ui" => "VNC password uses standard VNC video. Apple HEVC requires Mac account authentication.");color: root.muted;font-size: 12px;wrap: word-wrap;}
                                Caption { text: @tr("ui" => "CREDENTIAL PROTECTION"); color: root.muted; }
                                ComboBox {
                                    accessible-label: @tr("ui" => "Credential protection");
                                    model: [@tr("ui" => "Quick Connect"), @tr("ui" => "Windows Hello"), @tr("ui" => "Manual")];
                                    current-index <=> root.credential-mode;
                                    enabled: !root.connected && !root.connecting;
                                    selected => { root.use-saved = false; root.password = ""; root.credential-approved = false; }
                                }
                                Text {
                                    text: UiText.message(root.credential-mode == 0 ? @tr("ui" => "For a trusted PC. Programs running as your Windows user may access these credentials. Quick mode adds no separate hardware protection.") : (root.credential-mode == 1 ? @tr("ui" => "Windows Hello authorizes every saved-password read. You can enter the password manually if Hello is unavailable.") : @tr("ui" => "Device details are saved; the password is not persisted.")));
                                    color: root.muted; font-size: 12px; wrap: word-wrap;
                                }
                                CheckBox { text: @tr("ui" => "Automatically reconnect after an interrupted session"); checked <=> root.auto-reconnect; }
                                if root.has-saved && root.use-saved : GlassPanel {
                                    height: 140px; radius: 14px; background: root.selection;
                                    VerticalLayout {
                                        padding: 12px; spacing: 6px;
                                        Caption { text: UiText.message(root.credential-mode == 0 ? @tr("ui" => "Saved for quick connection") : @tr("ui" => "Windows Hello protected")); color: root.accent; }
                                        Text { text: @tr("ui" => "Saved passwords remain hidden. Hello mode requires approval; if unavailable, enter the password manually."); color: root.ink; font-size: 12px; wrap: word-wrap; }
                                        Button {
                                            text: @tr("ui" => "Update Password"); accessible-label: @tr("ui" => "Enter different credentials");
                                            enabled: !root.connected && !root.connecting;
                                            clicked => { root.use-saved = false; }
                                        }
                                    }
                                }
                                if !root.use-saved : VerticalLayout {
                                    spacing: 8px;
                                    if root.auth-mode == 0 : VerticalLayout {
                                        spacing: 6px;
                                        Caption { text: @tr("ui" => "Mac username"); }
                                        LineEdit { accessible-label: @tr("ui" => "Mac username"); text <=> root.username; placeholder-text: @tr("ui" => "Your macOS account"); enabled: !root.connected && !root.connecting; }
                                    }
                                    Caption { text: @tr("ui" => "Password"); }
                                    LineEdit { accessible-label: @tr("ui" => "Mac password"); text <=> root.password; input-type: InputType.password; placeholder-text: @tr("ui" => "Enter a password"); enabled: !root.connected && !root.connecting; }
                                    CheckBox {
                                        text: @tr("ui" => "I authorize saving this password with the selected protection");
                                        visible: root.credential-mode != 2;
                                        checked <=> root.credential-approved;
                                    }
                                    if root.has-saved : Button {
                                        text: @tr("ui" => "Use existing saved login");
                                        enabled: !root.connected && !root.connecting;
                                        clicked => { root.use-saved = true; root.credential-approved = false; }
                                    }
                                }
                                if root.selected >= 0 : Button { text: @tr("ui" => "Remove Mac…"); quiet: true; enabled: !root.connected && !root.connecting; clicked => { root.confirm-delete = !root.confirm-delete; } }
                                if root.confirm-delete : VerticalLayout {
                                    CheckBox { text: @tr("ui" => "Also delete saved credentials"); checked <=> root.delete-credentials; }
                                    Text { text: @tr("ui" => "Remove this saved Mac?"); color: root.ink; wrap: word-wrap; }
                                    HorizontalLayout {
                                        Button { text: @tr("ui" => "Keep Mac"); clicked => { root.confirm-delete = false; } }
                                        Button { text: @tr("ui" => "Remove Mac"); clicked => { root.delete-machine(); root.confirm-delete = false; } }
                                    }
                                }

                } }
                Text { text: UiText.message(root.password != "" ? @tr("ui" => "Save & Connect verifies the new password before saving it securely.") : @tr("ui" => "Save keeps device details. Use Save & Connect to verify a new login.")); color: root.muted; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: @tr("ui" => "Save"); accessible-label: @tr("ui" => "Save machine"); enabled: !root.connected && !root.connecting && root.password == ""; clicked => { root.save-machine(); } }
                    Rectangle { background: transparent; horizontal-stretch: 1; }
                    Button { text: UiText.message(root.connecting ? @tr("ui" => "Connecting…") : @tr("ui" => "Save & Connect")); accessible-label: @tr("ui" => "Connect to Mac"); primary: true; enabled: !root.connected && !root.connecting && root.host != "" && (root.use-saved || root.password != ""); clicked => { root.connect-requested(); } }
                }
            }
        }
    }
    }
    if root.settings-open : Rectangle {
        background: #00000055;
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => { if event.text == Key.Escape { root.settings-open = false; return accept; } return reject; }
            GlassPanel {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: min(580px, parent.width - 48px); height: min(660px, parent.height - 48px);
                background: root.panel; raised: true;
                VerticalLayout {
                    padding: 24px; spacing: 16px;
                    HorizontalLayout {
                        Text { text: @tr("ui" => "Settings"); color: root.ink; font-size: 22px; font-weight: 600; horizontal-stretch: 1; }
                        Button { text: @tr("ui" => "Close"); clicked => { root.settings-open = false; } }
                    }
                    ScrollView {
                        horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
                        VerticalLayout {
                            spacing: 12px;
                            Caption { text: @tr("ui" => "GENERAL"); color: root.muted; }
                            Caption { text: @tr("ui" => "Language"); }
                            ComboBox {
                                accessible-label: @tr("ui" => "Language"); height: 36px; vertical-stretch: 0;
                                model: [@tr("ui" => "System Default"), "简体中文", @tr("ui" => "English")];
                                current-index <=> root.language-index;
                                selected => { root.language-changed(self.current-index); }
                            }

                            Text { text: @tr("ui" => "Theme and motion follow Windows automatically."); color: root.muted; font-size: 13px; wrap: word-wrap; }
                            Caption { text: @tr("ui" => "CONNECTION"); color: root.muted; }
                            Text { text: @tr("ui" => "Authentication, password protection and automatic reconnection are configured per Mac. Choose Edit on a device card."); color: root.muted; font-size: 13px; wrap: word-wrap; }
                            Caption { text: @tr("ui" => "DISPLAY & QUALITY"); color: root.muted; }
                            HorizontalLayout { alignment: start; Button { text: @tr("ui" => "Picture & connection"); clicked => { root.settings-open = false; root.quality-open = true; } } CheckBox { width: 160px; text: @tr("ui" => "Show FPS"); checked <=> root.show-fps; toggled => { root.save-preferences(); } } }
                            Caption { text: @tr("ui" => "KEYBOARD & SHORTCUTS"); color: root.muted; }
                            CheckBox { text: @tr("ui" => "Ctrl shortcuts act as Command"); checked <=> root.ctrl-as-command; toggled => { root.save-preferences(); } }
                            Caption { text: @tr("ui" => "CLIPBOARD"); color: root.muted; }
                            Text { text: @tr("ui" => "Connect to a Mac to manage clipboard sharing from the toolbar."); color: root.muted; font-size: 13px; wrap: word-wrap; }
                            Caption { text: @tr("ui" => "SECURITY & CREDENTIALS"); color: root.muted; }
                            Text { text: @tr("ui" => "Quick Connect saves your password with your approval. Windows Hello verifies each saved-password read. Manual never saves a password. Passwords stay in Windows Credential Manager."); color: root.muted; font-size: 13px; wrap: word-wrap; }
                            Text { text: @tr("ui" => "Apple HEVC uses encrypted control and SRTP video. Standard VNC traffic is not encrypted; use a trusted network or VPN for remote access."); color: root.muted; font-size: 13px; wrap: word-wrap; }
                            Caption { text: @tr("ui" => "ABOUT & UPDATES"); color: root.muted; }
                            Text { text: UiText.message(Branding.display-name + " " + root.app-version + @tr("ui" => " · Fork development build")); color: root.ink; font-size: 13px; }
                            Text { text: UiText.message(@tr("ui" => "Commit: ") + root.build-revision); color: root.muted; font-size: 12px; wrap: word-wrap; }
                            Text { text: @tr("ui" => "Update source: bluemoonandy/maccanvas on GitHub. Upstream packages cannot be installed by this updater."); color: root.muted; font-size: 12px; wrap: word-wrap; }
                            Text { text: UiText.message(root.update-status); color: root.muted; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout {
                                alignment: start; spacing: 8px;
                                Button { text: @tr("ui" => "About"); clicked => { root.settings-open = false; root.about-open = true; } }
                                Button { text: UiText.message(root.update-checking ? @tr("ui" => "Checking…") : @tr("ui" => "Check updates")); enabled: !root.update-checking && !root.update-installing && !root.update-restart-required; clicked => { root.settings-open = false; root.check-updates(); } }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.licenses-open : Rectangle {
        background: root.dark-theme ? #00000099 : #00000033;
        TouchArea { clicked => { root.licenses-open = false; if root.connected { root.focus-canvas(); } } }
        GlassPanel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(780px, parent.width - 48px); height: min(670px, parent.height - 48px);
            radius: 24px; raised: true;
            TouchArea { }
            VerticalLayout {
                padding: 24px; spacing: 12px;
                HorizontalLayout {
                    Text { text: @tr("ui" => "Open Source Licenses"); color: root.ink; font-size: 22px; font-weight: 600; }
                    Button { text: @tr("ui" => "Done"); accessible-label: @tr("ui" => "Close licenses"); clicked => { root.licenses-open = false; if root.connected { root.focus-canvas(); } } }
                }
                ScrollView { horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
                    Text { text: root.license-text; color: root.ink; wrap: word-wrap; font-size: 12px; }
                }
            }
        }
    }
    if root.display-open : Rectangle {
        background: root.dark-theme ? #00000099 : #00000033;
        TouchArea { clicked => { root.display-open = false; } }
        GlassPanel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(530px, parent.width - 48px); height: min(500px, parent.height - 48px);
            radius: 24px; raised: true;
            TouchArea { }
            VerticalLayout {
                padding: 24px; spacing: 12px;
                HorizontalLayout {
                    Text { text: @tr("ui" => "Display"); color: root.ink; font-size: 22px; font-weight: 600; }
                    Button { text: @tr("ui" => "Done"); accessible-label: @tr("ui" => "Close display settings"); clicked => { root.display-open = false; } }
                }
                Caption { text: @tr("ui" => "LOCAL DISPLAY SCALE"); }
                ComboBox {
                    accessible-label: @tr("ui" => "Display scale");
                    height: 36px; vertical-stretch: 0;
                    model: [@tr("ui" => "Fit to Window"), @tr("ui" => "Actual Size (1:1 physical pixels)"), @tr("ui" => "100% of Fit"), @tr("ui" => "125% of Fit"), @tr("ui" => "150% of Fit"), @tr("ui" => "175% of Fit"), @tr("ui" => "200% of Fit")];
                    current-index <=> root.display-mode;
                    selected => { root.display-mode-changed(self.current-index); }
                }
                Text { text: @tr("ui" => "Zoom enlarges the fitted view and may crop the edges. It does not change the Mac resolution. Actual Size maps one decoded pixel to one Windows physical pixel."); color: root.muted; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    Button { text: @tr("ui" => "Fit to Window"); accessible-label: @tr("ui" => "Reset display to Fit"); clicked => { root.display-mode-changed(0); root.pan-view = false; } }
                    Button { text: UiText.message(root.pan-view ? @tr("ui" => "Pan on") : @tr("ui" => "Drag to pan")); accessible-label: @tr("ui" => "Toggle local pan"); enabled: root.display-can-pan; primary: root.pan-view; clicked => { root.pan-view = !root.pan-view; root.display-open = false; } }
                }
                HorizontalLayout {
                    alignment: center; spacing: 6px;
                    Button { text: "←"; accessible-label: @tr("ui" => "Pan view left"); enabled: root.display-can-pan; clicked => { root.pan-step(-0.25, 0); } }
                    Button { text: "↑"; accessible-label: @tr("ui" => "Pan view up"); enabled: root.display-can-pan; clicked => { root.pan-step(0, -0.25); } }
                    Button { text: @tr("ui" => "Center"); accessible-label: @tr("ui" => "Center display view"); enabled: root.display-can-pan; clicked => { root.pan-step(0, 0); } }
                    Button { text: "↓"; accessible-label: @tr("ui" => "Pan view down"); enabled: root.display-can-pan; clicked => { root.pan-step(0, 0.25); } }
                    Button { text: "→"; accessible-label: @tr("ui" => "Pan view right"); enabled: root.display-can-pan; clicked => { root.pan-step(0.25, 0); } }
                }
                Text { text: UiText.message(root.pan-view ? @tr("ui" => "Pan mode: dragging moves only the local view. Turn Pan off to click or drag on the Mac.") : @tr("ui" => "Use the Pan button to drag the enlarged view, or use the arrow buttons above. Saved separately for each Mac.")); color: root.muted; font-size: 12px; wrap: word-wrap; }
            }
        }
    }
    if root.quality-open || root.help-open : Rectangle {
        background: root.dark-theme ? #00000099 : #00000033;
        TouchArea { clicked => { root.quality-open = false; root.help-open = false; } }
        GlassPanel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(620px, parent.width - 48px); height: min(700px, parent.height - 48px);
            radius: 24px; raised: true;
            TouchArea { }
            VerticalLayout {
                padding: 24px; spacing: 14px;
                HorizontalLayout {
                    Text { text: UiText.message(root.help-open ? @tr("ui" => "Compression, explained") : @tr("ui" => "Picture & connection")); color: root.ink; font-size: 22px; font-weight: 600; }
                    Button { text: @tr("ui" => "Close"); clicked => { root.help-open = false; root.quality-open = false; } }
                }
                if root.error-text != "" : Text { text: UiText.message(root.error-text); color: root.dark-theme ? #ff6961 : #b42318; wrap: word-wrap; font-size: 12px; }
                if !root.help-open : ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: quality-content.preferred-height;
                    quality-content := VerticalLayout {
                        spacing: 12px; padding-left: 4px; padding-right: 16px;
                        Text { text: @tr("ui" => "Default: HEVC / H.265 at up to 60 FPS, with adaptive bitrate."); color: root.muted; font-size: 12px; wrap: word-wrap; }
                        Caption { text: @tr("ui" => "Streaming mode"); }
                        ComboBox {
                            accessible-label: @tr("ui" => "Streaming mode");
                            accessible-action-set-value(value) => { self.current-value = value; }
                            height: 36px;
                            model: [@tr("ui" => "HEVC / H.265 - 60 FPS (default)"), @tr("ui" => "HEVC / H.265 - 30 FPS"), @tr("ui" => "Auto (lossless VNC)"), @tr("ui" => "ZRLE (lossless)"), @tr("ui" => "Tight (lossless)"), @tr("ui" => "Tight + JPEG (lossy)"), @tr("ui" => "Hextile (lossless)"), @tr("ui" => "Zlib (lossless)"), @tr("ui" => "Raw (uncompressed)"), @tr("ui" => "RRE (legacy)"), @tr("ui" => "CoRRE (legacy)")];
                            current-index <=> root.encoding-index;
                        }
                        Text { text: UiText.message(root.encoding-description); color: root.muted; font-size: 12px; wrap: word-wrap; }
                        Button { text: @tr("ui" => "Compare methods & bandwidth estimates"); clicked => { root.help-open = true; } }
                        if root.encoding-index >= 2 : HorizontalLayout {
                            Caption { text: UiText.message(@tr("ui" => "Compression effort: ") + round(root.compression-level)); }
                            Slider { accessible-label: @tr("ui" => "Compression effort"); minimum: 0; maximum: 9; step: 1; value <=> root.compression-level; enabled: root.encoding-index <= 5 || root.encoding-index == 7; }
                        }
                        if root.encoding-index >= 2 : Text { text: @tr("ui" => "0 = less CPU, potentially more traffic. 9 = more CPU, potentially fewer bytes. This is a server hint, not a bitrate."); color: root.muted; font-size: 11px; wrap: word-wrap; }
                        if root.encoding-index == 5 : HorizontalLayout {
                            Caption { text: UiText.message(@tr("ui" => "JPEG quality: ") + round(root.jpeg-quality)); }
                            Slider { accessible-label: @tr("ui" => "JPEG quality"); minimum: 0; maximum: 9; step: 1; value <=> root.jpeg-quality; }
                        }
                        if root.encoding-index >= 2 : CheckBox { text: @tr("ui" => "Use a manual bandwidth target"); checked <=> root.manual-bandwidth; }
                        if root.encoding-index < 2 : CheckBox { text: @tr("ui" => "Use a manual HEVC bitrate ceiling"); checked <=> root.manual-hevc-bitrate; }
                        if root.manual-hevc-bitrate && root.encoding-index < 2 : HorizontalLayout {
                            Caption { text: @tr("ui" => "HEVC bitrate (Mbps)"); }
                            LineEdit { accessible-label: @tr("ui" => "HEVC bitrate Mbps"); text <=> root.hevc-mbps; input-type: InputType.decimal; }
                        }
                        if root.manual-bandwidth && root.encoding-index >= 2 : HorizontalLayout {
                            Caption { text: @tr("ui" => "Target (Mbps)"); }
                            LineEdit { accessible-label: @tr("ui" => "Bandwidth target Mbps"); text <=> root.target-mbps; input-type: InputType.decimal; }
                        }
                        Text { text: UiText.message(root.encoding-index < 2 ? @tr("ui" => "Adaptive bitrate is the default. A manual ceiling requests your chosen Mbps from the Mac; static screens and encoder limits can lower the actual rate, and bursts may exceed it. Compression, JPEG quality and the VNC bandwidth target do not apply. Apply reconnects when changing transports, HEVC presets or the bitrate ceiling; saved logins require Windows Hello again.") : @tr("ui" => "Automatic means no bandwidth target. A manual target spaces screen requests based on received bytes; bursts can exceed it. Apply reconnects automatically when switching to or from HEVC. Other VNC changes apply live.")); color: root.muted; font-size: 12px; wrap: word-wrap; }
                        HorizontalLayout {
                            Caption { text: @tr("ui" => "Frame rate limit"); }
                            LineEdit { accessible-label: @tr("ui" => "Maximum FPS"); width: 88px; text <=> root.max-fps; input-type: InputType.number; }
                        }
                        CheckBox { text: @tr("ui" => "Show live FPS counter"); checked <=> root.show-fps; toggled => { root.save-preferences(); } }
                        Text { text: @tr("ui" => "FPS counts unique desktop images submitted for display, not monitor refreshes. An idle desktop correctly reads 0 FPS. Traffic measures VNC, HEVC/audio SRTP and SSH payloads in bits/s, excluding TCP/UDP/VPN overhead."); color: root.muted; font-size: 11px; wrap: word-wrap; }
                    }
                }
                if root.help-open : ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: guide-content.preferred-height;
                    guide-content := VerticalLayout {
                        spacing: 16px; padding-right: 16px;
                        Text { text: UiText.message(root.estimate-context); color: root.muted; font-size: 12px; wrap: word-wrap; }
                        for codec in root.codec-guide : VerticalLayout {
                            spacing: 6px;
                            Caption { text: UiText.message(codec.name); color: root.accent; }
                            Text { text: UiText.message(codec.detail); color: root.ink; font-size: 12px; wrap: word-wrap; }
                            Text { text: UiText.message(codec.estimate); color: root.muted; font-size: 11px; wrap: word-wrap; }
                            Rectangle { height: 1px; background: root.outline; }
                        }
                        Text {
                            text: @tr("ui" => "Standard VNC offers CopyRect and a Raw fallback; the Mac may ignore compression/JPEG hints. HEVC uses Apple's separate High Performance transport with encrypted control, SRTP video and optional audio. Video decoding is bundled; audio uses a separate converter. Mac account login and UDP on the VNC port and the next port are required. H.264 playback is not supported.");
                            color: root.muted; font-size: 12px; wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    Button { text: UiText.message(root.help-open ? @tr("ui" => "Back to quality") : @tr("ui" => "Restore defaults")); clicked => { if root.help-open { root.help-open = false; } else { root.reset-streaming(); } } }
                    Rectangle { background: transparent; horizontal-stretch: 1; }
                    if !root.help-open : Button { text: @tr("ui" => "Apply"); primary: true; enabled: !root.connecting && !root.update-installing && root.audit-error == ""; clicked => { root.apply-streaming(); } }
                }
            }
        }
    }
    if root.audio-open : AudioOverlay {
        supported: root.hevc-active; connected: root.connected; missing: root.audio-codec-missing;
        installing: root.audio-installing; status: root.audio-status;
        muted <=> root.audio-muted; volume <=> root.audio-volume;
        changed => { root.audio-changed(); }
        install => { root.audio-install(); }
        retry => { root.audio-retry(); }
        close => { root.audio-open = false; if root.connected { root.focus-canvas(); } }
    }
    if root.about-open : AboutOverlay {
        version: root.app-version; build-date: root.build-date; revision: root.build-revision;
        target: root.build-target; compiler: root.build-compiler; author: root.author-name; log-path: root.log-path;
        close => { root.about-open = false; if root.connected { root.focus-canvas(); } }
        open-link(index) => { root.about-link(index); }
        open-licenses => { root.show-licenses(); }
        open-logs => { root.open-logs(); }
    }

    if root.clipboard-open : ClipboardOverlay {
        native-available: root.connected && root.hevc-active;
        native-enabled <=> root.native-clipboard-enabled; native-receive <=> root.native-clipboard-receive;
        native-send <=> root.native-clipboard-send; native-files <=> root.native-clipboard-files;
        native-status: root.native-clipboard-status; native-changed => { root.native-clipboard-changed(); }
        auto-enabled <=> root.auto-clipboard-enabled; auto-to-mac <=> root.auto-clipboard-to-mac;
        auto-to-windows <=> root.auto-clipboard-to-windows; auto-limit <=> root.auto-clipboard-limit;
        auto-status: root.auto-clipboard-status; auto-changed => { root.auto-clipboard-changed(); }
        shared <=> root.clipboard-shared; mode: root.clipboard-mode; vnc-available: !root.hevc-active;
        host: root.files-host; port <=> root.files-port; username <=> root.files-username; password <=> root.files-password;
        has-saved: root.files-has-saved; use-saved <=> root.files-use-saved; connected: root.files-connected;
        connecting: root.files-connecting; busy: root.files-busy; key-pending: root.files-key-pending;
        fingerprint: root.files-fingerprint; key-algorithm: root.files-key-algorithm; key-command: root.files-key-command;
        status: root.files-status; error: root.files-error; progress: root.files-progress; progress-label: root.files-progress-label;
        changed => { root.clipboard-changed(); }
        close => { root.close-clipboard(); }
        paste-text => { root.paste-windows-text(); }
        connect => { root.files-connect(); }
        disconnect => { root.files-disconnect(); }
        approve(accepted) => { root.files-approve(accepted); }
        cancel => { root.files-cancel(); }
        copy-text => { root.files-copy-text(); }
        send-text => { root.files-send-text(); }
    }

    if root.native-files-open : NativeFilesOverlay {
        enabled-sharing <=> root.native-clipboard-enabled; allow-files <=> root.native-clipboard-files;
        send <=> root.native-clipboard-send; receive <=> root.native-clipboard-receive;
        destination <=> root.native-file-destination; source <=> root.native-file-source;
        status: root.native-clipboard-status; result: root.native-file-result; busy: root.native-file-busy; target: root.host;
        changed => { root.native-clipboard-changed(); }
        upload(folder) => { root.native-file-upload(folder); }
        download => { root.native-file-download(); }
        cancel => { root.native-file-cancel(); }
        close => { root.native-files-open = false; if root.connected { root.focus-canvas(); } }
    }

    if root.files-open : FilesOverlay {
        host: root.files-host; port <=> root.files-port; username <=> root.files-username; password <=> root.files-password;
        has-saved: root.files-has-saved; use-saved <=> root.files-use-saved; connected: root.files-connected;
        connecting: root.files-connecting; busy: root.files-busy; key-pending: root.files-key-pending;
        directory-ready: root.files-directory-ready;
        fingerprint: root.files-fingerprint; key-algorithm: root.files-key-algorithm; key-command: root.files-key-command;
        path <=> root.files-path; upload-name <=> root.files-upload-name; entries: root.file-entries;
        status: root.files-status; error: root.files-error; progress: root.files-progress; progress-label: root.files-progress-label;
        close => { root.files-close(); }
        connect => { root.files-connect(); }
        disconnect => { root.files-disconnect(); }
        approve(accepted) => { root.files-approve(accepted); }
        browse => { root.files-browse(); }
        up => { root.files-up(); }
        entry(index) => { root.files-entry(index); }
        upload => { root.files-upload(); }
        cancel => { root.files-cancel(); }
    }

    if root.update-banner && !root.update-installing && !root.modal-open : GlassPanel {
        x: max(16px, root.width - self.width - 20px);
        y: root.immersive ? 60px : 88px;
        width: min(390px, root.width - 32px); height: 226px; radius: 18px; raised: true;
        accessible-role: groupbox; accessible-label: @tr("ui" => "Application update notification");
        TouchArea { }
        VerticalLayout {
            padding: 18px; spacing: 10px;
            Text { text: UiText.message(root.update-restart-required ? @tr("ui" => "Restart required") : (root.update-available ? Branding.display-name + " " + root.update-version + @tr("ui" => " is ready") : @tr("ui" => "Update check"))); color: root.ink; font-size: 16px; font-weight: 600; }
            Text { text: @tr("ui" => "Source: bluemoonandy/maccanvas · GitHub"); color: root.muted; font-size: 12px; wrap: word-wrap; }
            Text { text: @tr("ui" => "Installing replaces this test build. A verified backup is kept for rollback."); color: root.muted; font-size: 12px; wrap: word-wrap; }
            Text {
                text: UiText.message(root.update-available && (root.connected || root.connecting) ? @tr("ui" => "Disconnect when you're ready to install and restart. Your saved Macs and logins will stay.") : root.update-status);
                color: root.muted; wrap: word-wrap; font-size: 12px;
            }
            HorizontalLayout {
                Button { text: @tr("ui" => "Later"); clicked => { root.dismiss-update(); } }
                Rectangle { background: transparent; horizontal-stretch: 1; }
                Button {
                    text: UiText.message(root.update-restart-required ? @tr("ui" => "Restart needed") : (root.update-available ? @tr("ui" => "Update & restart") : @tr("ui" => "Retry")));
                    primary: true; enabled: root.brand-updates-ready && !root.update-checking && !root.connected && !root.connecting && !root.update-restart-required;
                    clicked => { if root.update-available { root.install-update(); } else { root.check-updates(); } }
                }
            }
        }
    }
    if root.update-installing : Rectangle {
        background: #00000066;
        TouchArea { }
        GlassPanel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(460px, parent.width - 48px); height: 180px; radius: 22px; raised: true;
            VerticalLayout {
                padding: 24px; spacing: 16px;
                Text { text: @tr("ui" => "Updating application"); color: root.ink; font-size: 21px; font-weight: 600; }
                Text { text: UiText.message(root.update-status); color: root.muted; wrap: word-wrap; font-size: 13px; }
                Rectangle {
                    height: 5px; border-radius: 3px; background: root.outline;
                    Rectangle { width: parent.width * root.update-progress; background: root.accent; border-radius: 3px; }
                }
                Text { text: @tr("ui" => "Keep this window open. The application will restart when ready."); color: root.muted; font-size: 11px; wrap: word-wrap; }
            }
        }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => { return accept; }
            key-released(event) => { return accept; }
        }
    }
}
